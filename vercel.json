{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/.next",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  }
}
