{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter api migrate && pnpm build",
  "outputDirectory": "apps/web/.next",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" }
  ],
  "crons": [
    { "path": "/api/reports/monthly/run", "schedule": "0 17 1 * *" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  }
}
