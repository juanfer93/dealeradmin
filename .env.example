NODE_ENV=development
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dealeradmin?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
GHL_WEBHOOK_SECRET=replace-with-a-random-shared-secret
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace$replace
PORT=3001

# Monthly lead report delivery. Keep disabled until SMTP credentials are configured securely.
MONTHLY_REPORTS_ENABLED=false
MONTHLY_REPORTS_FROM=jfpi_0793@icloud.com
MONTHLY_REPORTS_TO=pixelmediacolombia@gmail.com
MONTHLY_REPORTS_TIMEZONE=America/Bogota
MONTHLY_REPORTS_SEND_HOUR=12
MONTHLY_REPORTS_SEND_MINUTE=0
MONTHLY_REPORTS_SMTP_HOST=smtp.mail.me.com
MONTHLY_REPORTS_SMTP_PORT=587
MONTHLY_REPORTS_SMTP_SECURE=false
MONTHLY_REPORTS_SMTP_USER=jfpi_0793@icloud.com
MONTHLY_REPORTS_SMTP_PASSWORD=replace-with-an-icloud-app-specific-password
MONTHLY_REPORTS_DRY_RUN=false
# Vercel cron / protected manual scheduler secret; never commit the real value.
CRON_SECRET=replace-with-a-random-cron-secret
